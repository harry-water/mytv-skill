{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MyTV existing local metadata sidecar",
  "type": "object",
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "capture_date": {
      "type": "string",
      "format": "date"
    },
    "capture_time": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "required": [
        "label",
        "confirmed"
      ],
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "confirmed": {
          "type": "boolean"
        }
      }
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "confirmed"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "confirmed": {
            "type": "boolean"
          }
        }
      }
    },
    "gps": {
      "type": "object",
      "required": [
        "latitude",
        "longitude",
        "confirmed"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "confirmed": {
          "type": "boolean"
        }
      }
    }
  },
  "description": "Adjacent MEDIA.ext.mytv.json. Offsetless time remains unknown; mtime is never capture time. Only confirmed labels consumed; time takes priority over date. Runtime validates IANA names. No recognition or cloud access."
}
